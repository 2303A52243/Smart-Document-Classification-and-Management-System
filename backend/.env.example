# ─── Smart Document Management System — Backend Environment Variables ────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application
DEBUG=true
PORT=8000

# MongoDB Connection (Local or Atlas)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_doc_db

# Security & Authentication
# In production, use a strong random secret: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document Processing & NLP Configuration
MAX_FILE_SIZE_MB=15
CONFIDENCE_THRESHOLD=0.40
UPLOADS_DIR=uploads
MODELS_DIR=models

# Persistent Storage Backend:
# Options: "local" (default for development/Docker) or "s3" (production object storage)
STORAGE_BACKEND=local

# S3-Compatible Cloud Storage (Cloudflare R2 / Supabase / AWS S3)
# Cloudflare R2 offers 10 GB free storage with zero egress bandwidth fees.
S3_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=smart-doc-vault
S3_REGION=auto
