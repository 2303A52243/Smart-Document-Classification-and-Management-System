# ─── Environment Configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# MongoDB connection string (local or Atlas)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_doc_db

# JWT secret — CHANGE THIS to a long random string in production
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File upload limits
MAX_FILE_SIZE_MB=15

# NLP confidence threshold (predictions below this are flagged for review)
CONFIDENCE_THRESHOLD=0.40

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Debug mode
DEBUG=true

