# ==============================================================================
# Smart Document Classification and Management System Environment Configuration
# Safe placeholder configuration file — Copy to .env for local deployment
# NEVER commit .env to version control
# ==============================================================================

# Application Runtime
ENVIRONMENT=development
DEBUG=true

# Database Configuration (MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_doc_db

# Security & Authentication (Generate a random 32+ character key for production)
JWT_SECRET_KEY=change-this-secret-in-production-min-32-chars-long-security-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Policy
MAX_FILE_SIZE_MB=15

# NLP Classification Confidence Threshold
# Predictions with calibrated probability below this value will be marked as "Needs Review"
CONFIDENCE_THRESHOLD=0.40

# Network & CORS
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
